# Copia este archivo a .env.local (y .env para drizzle-kit) y rellena los valores.
# Cada vez que agregues una variable aquí, agrégala también en Vercel (sección 6 de los requerimientos).

# Neon: cadena de la rama "dev" en local; en Vercel, la de la rama "main".
DATABASE_URL="postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js: `npx auth secret` o `openssl rand -base64 32`.
AUTH_SECRET=""

# Google Cloud > APIs y servicios > Credenciales > ID de cliente OAuth (aplicación web).
# URIs de redirección: /api/auth/callback/google (login) y /api/drive/callback (Drive).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Picker (elegir la carpeta del negocio y las planillas a importar).
# Clave de API restringida a Picker API, y el número del proyecto de Google Cloud.
NEXT_PUBLIC_GOOGLE_API_KEY=""
NEXT_PUBLIC_GOOGLE_APP_ID=""

# Cifra el refresh token de Drive en la base de datos (mínimo 32 caracteres).
# `openssl rand -base64 48`. Si la cambias, hay que volver a conectar Drive.
DRIVE_ENCRYPTION_KEY=""

# Lo envía el cron de Vercel al llamar a /api/cron/respaldo. `openssl rand -hex 32`.
CRON_SECRET=""

# Opcional: correo del primer administrador para `pnpm db:seed-admin`.
ADMIN_EMAIL=""

# Nombre del estudio que aparece en el login y la barra lateral.
NEXT_PUBLIC_STUDIO_NAME="Estudio"

# Solo desarrollo: usar un Postgres local detrás de un proxy HTTP compatible con Neon.
# NEON_FETCH_ENDPOINT="http://localhost:4444/sql"
